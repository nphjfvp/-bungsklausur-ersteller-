# ─────────────────────────────────────────────────────────────
# Für den normalen Betrieb brauchst du diese Datei NICHT.
#
# Die App läuft ohne Server: Der OpenRouter-Key und die
# Firebase-Konfiguration werden in der App unter /settings
# eingetragen und bleiben lokal im Browser.
# ─────────────────────────────────────────────────────────────

# Unterpfad, unter dem die App liegt. Auf GitHub Pages setzt der
# Workflow das automatisch auf /<repo-name>. Lokal leer lassen.
NEXT_PUBLIC_BASE_PATH=

# Firebase (optionale Geräte-Synchronisierung). Diese Werte lassen sich
# alternativ direkt in der App eintragen — was meist bequemer ist, weil
# sie dann nicht im Build landen.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
