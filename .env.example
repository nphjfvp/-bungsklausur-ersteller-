# ─────────────────────────────────────────────────────────────
# Alles hier ist OPTIONAL. Die App läuft auch komplett ohne .env:
# den OpenRouter-Key und die Firebase-Config kannst du stattdessen
# direkt in der App unter /settings eintragen (bleibt dann lokal
# im Browser gespeichert und wird nie synchronisiert).
# ─────────────────────────────────────────────────────────────

# OpenRouter-Key serverseitig hinterlegen. Ist er gesetzt, laufen alle
# KI-Aufrufe über /api/openrouter und der Key verlässt den Server nie.
OPENROUTER_API_KEY=

# Wird von OpenRouter für die Rangliste genutzt (rein kosmetisch).
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Übungsklausur-Ersteller

# Firebase (optionale Geräte-Synchronisierung). Ohne diese Werte
# arbeitet die App rein lokal in IndexedDB.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
